# ============================================================================
# GAIA Framework — .gitignore
# ============================================================================

# ------------------------------------
# Environment & Secrets
# ------------------------------------
.env
.env.*
.env.local
*.pem
*.key
*.p12
*.pfx
*.cert
secrets/
credentials/
private/

# ------------------------------------
# Node.js
# ------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
package-lock.json

# ------------------------------------
# Python
# ------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
.tox/

# ------------------------------------
# Terraform
# ------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ------------------------------------
# IDE
# ------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ------------------------------------
# OS
# ------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# ------------------------------------
# Build & Logs
# ------------------------------------
dist/
out/
*.log
logs/
tmp/
temp/

# ------------------------------------
# Docker
# ------------------------------------
.docker/

# ------------------------------------
# .NET
# ------------------------------------
bin/
obj/
*.suo
*.user
*.userosscache
*.sln.docstates
packages/
*.nupkg
